# MySQL 8+ database used by Prisma for the demo user, search history, and entitlements.
DATABASE_URL="mysql://pantry_index_app:replace-with-local-password@127.0.0.1:3306/packaged_food"

# Browser origin for Checkout return URLs and CORS.
APP_URL="http://127.0.0.1:3000"

# Use real Stripe test-mode credentials and a recurring monthly Price ID for the
# hosted Checkout flow. Do not commit the filled-in .env file.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_ID="price_replace_me"

# Local service selections. The defaults exercise the assignment integrations.
# The focused tests set the corresponding in-memory/mock values themselves.
SEARCH_HISTORY_STORE="prisma"
PAYMENTS_STORE="prisma"
PAYMENTS_PROVIDER="stripe"
NUTRITION_PROVIDER="openfoodfacts"
