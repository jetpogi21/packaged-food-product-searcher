{
  "name": "packaged-food-product-searcher",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@food-search/api",
    "dev:web": "npm run dev --workspace=@food-search/web",
    "test:servers": "node scripts/start-test-servers.mjs",
    "test:product-search": "playwright test tests/product-search.spec.ts",
    "test:recent-searches": "playwright test tests/recent-searches.spec.ts",
    "test:localization": "playwright test tests/localization.spec.ts",
    "test:payments": "playwright test tests/payments.spec.ts",
    "test:checkout-entitlement": "playwright test tests/checkout-entitlement.spec.ts",
    "test:checkout-return-status": "playwright test tests/checkout-return-status.spec.ts",
    "test:responsive-layout": "playwright test tests/responsive-layout.spec.ts",
    "test:subscription-unlock-panel": "playwright test tests/subscription-unlock-panel.spec.ts",
    "test:checkout-return-context": "playwright test tests/checkout-return-context.spec.ts",
    "test:search-first-localized-checkout": "playwright test tests/search-first-localized-checkout.spec.ts",
    "test:checkout-cors": "playwright test tests/checkout-cors.spec.ts",
    "test:checkout-association": "playwright test tests/checkout-association.spec.ts",
    "verify:submission": "node scripts/check-submission-artifacts.mjs",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.0"
  }
}
